# Every variable here is optional. With none of them set the app runs on
# in-memory mock data and boots anywhere, including Vercel.

# Secret used to sign access tokens (HS256). Generate with: openssl rand -base64 32
# Rotating it invalidates every access token; refresh tokens keep working.
# Required (>=32 chars) in production once DATABASE_URL is set.
AUTH_SECRET=

# Postgres connection string (Neon, Vercel Postgres, Supabase, local...).
# Leave unset to serve mock data from memory (lib/server/mock) -- no database,
# no filesystem writes. Set it to switch to real Postgres over Drizzle, then run
# `DATABASE_URL=... npm run db:setup` once to create and seed the schema.
DATABASE_URL=

# Token lifetimes. Defaults are deliberately short so the refresh path is observable.
ACCESS_TOKEN_TTL_SECONDS=60
REFRESH_TOKEN_TTL_SECONDS=604800
SESSION_ABSOLUTE_TTL_SECONDS=2592000
# A refresh token presented again within this window after rotation is treated as a
# concurrent request from the same client, not as theft.
REFRESH_GRACE_SECONDS=15
